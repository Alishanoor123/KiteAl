{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs server.cjs.map",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.1.10",
    "autoprefixer": "^10.4.21",
